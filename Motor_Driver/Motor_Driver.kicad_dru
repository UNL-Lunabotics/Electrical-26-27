(version 1)

(rule "RP2040 fanout"
  (condition "A.intersectsCourtyard('U1') || A.intersectsCourtyard('U10')")
  (constraint track_width (min 0.15mm))
  (constraint clearance (min 0.15mm)))

(rule "thin_12V_tracks"
  (condition "A.NetName == '+12V' && A.Type == 'Track' && A.Width < 1mm")
  (constraint clearance (min 0.2mm)))

(rule "12V_vias"
  (condition "A.NetName == '+12V' && A.Type == 'Via'")
  (constraint clearance (min 0.2mm)))

(rule "QSPI_fanout"
  (condition "A.NetName == 'RP_*' && B.NetName == 'RP_*'")
  (constraint clearance (min 0.15mm)))

(rule "J1_NPTH"
  (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
  (constraint hole_clearance (min 0.15mm)))