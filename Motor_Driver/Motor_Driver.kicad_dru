(version 1)
   (rule "RP2040 fanout"
     (condition "A.intersectsCourtyard('U1') || A.intersectsCourtyard('U10')")
     (constraint track_width (min 0.15mm))
     (constraint clearance (min 0.15mm)))
(version 1)
(rule "thin_12V_feeds"
  (condition "A.NetName == '+12V' && (A.Type == 'Track' || A.Type == 'Via') && A.Width < 1mm")
  (constraint clearance (min 0.2mm)))